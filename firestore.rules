rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Entitlement (subscription) state: a server-written Stripe mirror plus a
    // manual override. Reads use ternary short-circuit on exists() plus
    // map .get(key, default) so missing docs/fields deny safely: get() never
    // runs on an absent doc and field reads carry defaults. These helpers
    // gate the sync surface (ENC-238) and are shared with the Storage
    // rules (ENC-239).
    function isOverrideEntitled(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/entitlement/override;
      return exists(p) ? get(p).data.get('freeAccess', false) == true : false;
    }

    function isStripeEntitled(uid) {
      let p = /databases/$(database)/documents/users/$(uid)/entitlement/stripe;
      return exists(p)
        ? (get(p).data.get('active', false) == true
          && get(p).data.get('expiryTimeMillis', 9999999999999) > request.time.toMillis())
        : false;
    }

    function isEntitled(uid) {
      return isOwner(uid) && (isOverrideEntitled(uid) || isStripeEntitled(uid));
    }

    function isServerOwnedSyncCollection(collection) {
      return collection == 'sync_events'
        || collection == 'sync_meta'
        || collection == 'sync_processed_events';
    }

    function isAllowlistedEntityCollection(collection) {
      return collection == 'chats'
        || collection == 'messages'
        || collection == 'chat_summaries'
        || collection == 'memories'
        || collection == 'vision_analysis'
        || collection == 'message_files'
        || collection == 'web_search_sources'
        || collection == 'search_tool_settings'
        || collection == 'message_transcript_segments'
        || collection == 'message_inference_telemetry'
        || collection == 'documents'
        || collection == 'api_credentials'
        || collection == 'api_keys'
        || collection == 'api_model_configs'
        || collection == 'local_models'
        || collection == 'utility_models'
        || collection == 'local_model_configs'
        || collection == 'default_models'
        || collection == 'tts_providers'
        || collection == 'live_voice_providers'
        || collection == 'media_providers'
        || collection == 'studio_albums'
        || collection == 'studio_gallery';
    }

    function hasStringField(fieldName) {
      return request.resource.data.keys().hasAny([fieldName])
        && request.resource.data[fieldName] is string;
    }

    function hasNumberField(fieldName) {
      return request.resource.data.keys().hasAny([fieldName])
        && request.resource.data[fieldName] is number;
    }

    function validSyncMetadata() {
      return (!request.resource.data.keys().hasAny(['_sync_device_id']) || hasStringField('_sync_device_id'))
        && (!request.resource.data.keys().hasAny(['_sync_client_mutation_id'])
          || hasStringField('_sync_client_mutation_id'))
        && (!request.resource.data.keys().hasAny(['_sync_written_at']) || hasNumberField('_sync_written_at'));
    }

    // Owner-scoped user document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Allowlisted entity collections: owner read/write only for known synced
      // entity collections. Server-owned sync collections are handled below.
      // Sync surface is entitlement-gated: reads and writes require an active
      // entitlement, but deletes are carved out so users can always purge
      // their cloud data. DEPLOY SEQUENCING (ENC-244): the writer + override
      // functions must deploy before this rule or entitled clients lose sync.
      match /{collection}/{document} {
        allow read: if isOwner(uid)
          && isAllowlistedEntityCollection(collection)
          && isEntitled(uid);
        allow create, update: if isOwner(uid)
          && isAllowlistedEntityCollection(collection)
          && validSyncMetadata()
          && isEntitled(uid);
        allow delete: if isOwner(uid) && isAllowlistedEntityCollection(collection);
      }

      // Server-owned sync feed: entitled owners may READ their own events, but
      // never write. Cloud Functions use the Admin SDK and are not constrained
      // by these rules.
      match /sync_events/{eventId} {
        allow read: if isOwner(uid) && isEntitled(uid);
        allow write: if false;
      }

      match /sync_meta/{doc} {
        allow read: if isOwner(uid) && isEntitled(uid);
        allow write: if false;
      }

      // Entitlement state (Stripe mirror + manual override): owners may read
      // their own docs; all client writes are server-only via the Admin SDK.
      match /entitlement/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Server-only idempotency ledger — clients may not read or write.
      match /sync_processed_events/{doc} {
        allow read, write: if false;
      }
    }

    // Public/shared content remains readable; writes restricted to Cloud Functions.
    match /shared_chats/{shareId} {
      allow read: if true;
      allow write: if false;
    }

    // Stripe customer-to-uid mapping: server-only via the Admin SDK. Clients
    // may neither read nor write; the webhook maintains these docs.
    match /stripe_customers/{customerId} {
      allow read, write: if false;
    }

    // Write-only moderation reports for false positives/negatives.
    match /moderation/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['prompt', 'outcome', 'timestamp', 'version'])
        && request.resource.data.keys().hasOnly(['prompt', 'outcome', 'timestamp', 'version'])
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() < 5000
        && request.resource.data.outcome in ['blocked', 'allowed']
        && request.resource.data.timestamp is timestamp
        && request.resource.data.version == 1;
      allow read, update, delete: if false;
    }
  }
}
