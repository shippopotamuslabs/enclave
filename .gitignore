# Exclude generated model binaries and tokenizers from git tracking.
# Only committed JSON configs (model_config.json, config.json) ship in source;
# large binary model weights are regenerated by scripts/export_*_onnx.py and
# the like, and are never committed. Ignoring by extension (not by directory)
# so configs and other source files commit normally without `git add -f`.
/app/src/main/assets/models/**/*.onnx
/app/src/main/assets/models/**/*.tflite
/app/src/main/assets/models/**/*.litertm
/app/src/main/assets/models/**/*.pt
/app/src/main/assets/models/**/*.bin
/app/src/main/assets/models/**/*.safetensors
/app/src/main/assets/models/**/*.h5
/app/src/main/assets/models/**/*.pb
/app/src/main/assets/models/**/*.gguf
/app/src/main/assets/models/**/tokenizer.json
/app/src/main/assets/models/**/tokenizer_config.json
/app/src/main/assets/models/**/vocab.json
/app/src/main/assets/models/**/vocab.txt
/app/src/main/assets/models/**/merges.txt
/app/src/main/assets/models/**/special_tokens_map.json
/app/src/main/assets/models/**/ort_config.json

# ONNX export scratch files (scripts/export_*_onnx.py)
sym_shape_infer_temp.onnx
build/image_safety_classifier_export/
