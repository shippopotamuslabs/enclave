{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && mocha 'lib/**/*.test.js' --ignore 'lib/**/*.rules.test.js'",
    "test:rules": "npm run build && firebase emulators:exec --only firestore,storage --project enclave-storage-entitlement-test \"mocha lib/*.rules.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.7.0",
    "marked": "^12.0.0",
    "pdf-parse": "^1.1.1",
    "stripe": "^23.0.1",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/sinon": "^17.0.0",
    "@types/uuid": "^10.0.0",
    "chai": "^4.3.0",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^14.0.0",
    "mocha": "^10.0.0",
    "sinon": "^17.0.1",
    "typescript": "^5.0.0"
  },
  "private": true
}
