rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Entitlement (subscription) state: a server-written Stripe mirror plus a
    // manual override. Reads use ternary short-circuit on firestore.exists()
    // plus map .get(key, default) so missing docs/fields deny safely: get()
    // never runs on an absent doc and field reads carry defaults.
    // Mirrors firestore.rules isEntitled (ENC-238) — keep in sync.
    function isOverrideEntitled(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid)/entitlement/override)
        ? firestore.get(/databases/(default)/documents/users/$(uid)/entitlement/override).data.get('freeAccess', false) == true
        : false;
    }

    function isStripeEntitled(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid)/entitlement/stripe)
        ? (firestore.get(/databases/(default)/documents/users/$(uid)/entitlement/stripe).data.get('active', false) == true
          && firestore.get(/databases/(default)/documents/users/$(uid)/entitlement/stripe).data.get('expiryTimeMillis', 9999999999999) > request.time.toMillis())
        : false;
    }

    function isEntitled(uid) {
      return request.auth != null && (isOverrideEntitled(uid) || isStripeEntitled(uid));
    }

    // 1. User-scoped private blobs (studio media, message file attachments, etc.)
    // Paths: users/{uid}/media/{id}, users/{uid}/files/{id}, ...
    // Reads and writes require an active entitlement; deletes are carved out
    // so users can always purge their own objects.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && isEntitled(userId);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isEntitled(userId)
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Shared chat media (encrypted blobs; public read for share web page)
    // Upload order: client writes Storage first, then uploadSharedChat creates Firestore doc.
    // Write gate pairs with uploadSharedChat callable assert (ENC-240)
    // because client uploads media before calling it.
    match /shared_chat_media/{shareId}/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && isEntitled(request.auth.uid)
        && request.resource.size < 50 * 1024 * 1024 // 50 MB
        && (
          !firestore.exists(/databases/(default)/documents/shared_chats/$(shareId))
          || firestore.get(/databases/(default)/documents/shared_chats/$(shareId)).data.ownerId
            == request.auth.uid
        );
      allow delete: if false; // cleanupExpiredShares uses Admin SDK
    }

    // 3. Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
