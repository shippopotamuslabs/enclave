rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. User-specific private data (Media, Studio photos, and File attachments)
    // Only the owner can read or write these files.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                         && request.resource.size < 100 * 1024 * 1024; // 100MB Limit
    }

    // 2. Shared Chat Media
    // Publicly readable so recipients can view images
    match /shared_chat_media/{shareId}/{mediaId} {
      allow read: if true;
      // Only the owner of the shared chat can write to its media folder.
      allow write: if request.auth != null && 
                   firestore.get(/databases/(default)/documents/shared_chats/$(shareId)).data.ownerId == request.auth.uid
                   && request.resource.size < 50 * 1024 * 1024; // 50MB Limit
    }

    // 3. Global Safety: Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
