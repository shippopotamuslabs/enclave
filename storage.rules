rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. User-scoped private blobs (studio media, message file attachments, etc.)
    // Paths: users/{uid}/media/{id}, users/{uid}/files/{id}, ...
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Shared chat media (encrypted blobs; public read for share web page)
    // Upload order: client writes Storage first, then uploadSharedChat creates Firestore doc.
    match /shared_chat_media/{shareId}/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024 // 50 MB
        && (
          !firestore.exists(/databases/(default)/documents/shared_chats/$(shareId))
          || firestore.get(/databases/(default)/documents/shared_chats/$(shareId)).data.ownerId
            == request.auth.uid
        );
      allow delete: if false; // cleanupExpiredShares uses Admin SDK
    }

    // 3. Temporary extraction uploads (cloud doc pipeline; owner write-only)
    match /temp_extractions/{userId}/{fileId} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10 MB
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Temporary generation scratch files (owner read/write/delete)
    match /temp_generations/{userId}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10 MB
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 5. Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
